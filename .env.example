# Copia este archivo como .env para probar en tu computador.
FLASK_APP=wsgi.py
SECRET_KEY=algo-largo-y-secreto
DATABASE_URL=sqlite:///reservared.db
NOMBRE_NEGOCIO=Mi consulta
URL_PUBLICA=http://localhost:5000
ADMIN_EMAIL=tu@correo.cl
ADMIN_CLAVE=una-clave-temporal

# Correo (por ejemplo Brevo, Gmail con contraseña de aplicación, Zoho)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=

# Mercado Pago → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=

# Webpay Plus (Transbank). Para probar sin contrato: WEBPAY_AMBIENTE=integracion
WEBPAY_CODIGO_COMERCIO=
WEBPAY_LLAVE_SECRETA=
WEBPAY_AMBIENTE=integracion

# WhatsApp Business (Meta)
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=

# Clave de la tarea de recordatorios
CLAVE_TAREAS=

# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
